        "width": 4,
        "height": 1,
        "head": "",
        "format": "<template><div class=\"sv-info\"><span><b>Tapis à bande · moteur brushless</b></span><span class=\"sv-tag\">OPC UA · 10.16.24.155:4840</span></div></template>\n<style>\n.sv-info{display:flex;justify-content:space-between;align-items:center;width:100%;font-size:13px;color:rgba(var(--v-theme-on-surface),.65)}\n.sv-info b{color:rgb(var(--v-theme-on-surface));font-weight:600}\n.sv-tag{font-family:monospace;font-size:12px;padding:2px 8px;border-radius:6px;background:rgba(var(--v-theme-on-surface),.07)}\n.sv-badge{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;width:100%;height:100%;padding:6px 0}\n.sv-label{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:rgba(var(--v-theme-on-surface),.6);font-weight:600;text-align:center}\n.sv-pill{display:inline-flex;align-items:center;gap:8px;padding:6px 16px;border-radius:999px;font-weight:700;font-size:14px;letter-spacing:.03em}\n.sv-pill.on{background:rgba(30,158,90,.14);color:#1e9e5a}\n.sv-pill.off{background:rgba(214,69,69,.14);color:#d64545}\n.sv-pill.na{background:rgba(120,120,120,.14);color:#8a8a8a}\n.sv-dot{width:10px;height:10px;border-radius:50%;background:currentColor}\n.sv-pill.on .sv-dot{box-shadow:0 0 0 4px rgba(30,158,90,.25)}\n.sv-var{font-family:monospace;font-size:11px;color:rgba(var(--v-theme-on-surface),.45)}\n.sv-convoyeur{border-top:4px solid #f08a00 !important}.sv-synchrone{border-top:4px solid #0b5cad !important}.sv-stepper{border-top:4px solid #7a4bd1 !important}</style>",
