        "head": "",
        "format": "<template><div class=\"sv-badge\"><div class=\"sv-label\">Mise sous tension</div>\n<div :class=\"['sv-pill', known ? (isOn ? 'on' : 'off') : 'na']\"><span class=\"sv-dot\"></span>{{ known ? (isOn ? 'ALIMENTÉ' : 'HORS TENSION') : 'EN ATTENTE' }}</div>\n<div class=\"sv-var\">gMarcheConv</div></div></template>\n<script>\nexport default {\n  computed: {\n    known() { return !!this.msg && this.msg.payload !== undefined },\n    isOn() { const p = this.msg && this.msg.payload; return p === true || p === 1 || p === '1' || String(p).toLowerCase() === 'true' || String(p).toUpperCase() === 'ON' }\n  }\n}\n</script>",
